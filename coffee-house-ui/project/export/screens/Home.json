        { "imageUrl": "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=200&h=200&fit=crop&q=80", "label": "Cold brew", "seen": false },
        { "imageUrl": "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=200&h=200&fit=crop&q=80", "label": "Espresso", "seen": false },
        { "imageUrl": "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=200&h=200&fit=crop&q=80", "label": "Pastries", "seen": true },
