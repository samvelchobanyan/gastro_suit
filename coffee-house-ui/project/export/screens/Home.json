        { "key": "home", "icon": "house", "label": "Home" },
        { "key": "order", "icon": "coffee", "label": "Order" },
        { "key": "gifts", "icon": "gift", "label": "Gifts" },
        { "key": "profile", "icon": "user", "label": "Profile" }
