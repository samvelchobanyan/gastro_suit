        { "component": "BranchCard", "props": { "name": "Northern Avenue", "address": "12 Northern Ave, Yerevan", "hours": "08:00 – 23:00", "distance": "0.4 km", "isOpenNow": true, "image": "assets/branch_1.png" } },
        { "component": "Divider" },
        { "component": "BranchCard", "props": { "name": "Cascade", "address": "3 Tamanyan St, Yerevan", "hours": "09:00 – 22:00", "distance": "1.1 km", "isOpenNow": true, "image": "assets/branch_2.png" } },
        { "component": "Divider" },
        { "component": "BranchCard", "props": { "name": "Republic Square", "address": "5 Abovyan St, Yerevan", "hours": "08:00 – 00:00", "distance": "1.8 km", "isOpenNow": false, "image": "assets/branch_3.png" } }
