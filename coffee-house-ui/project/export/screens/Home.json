        { "href": "#", "image": "assets/promo_1png.png", "alt": "Horizon · Stephan Bodzin" },
        { "href": "#", "image": "assets/promo_2.png", "alt": "App exclusive combos" },
        { "href": "#", "image": "assets/promo_3.png", "alt": "Iconic Armo Y2K Diva's playlist" }
      ]
    },
    {
      "component": "SectionHeader",
      "title": "Nearest branches",
      "titleGap": "var(--space-md)",
      "gap": "var(--space-md)",
      "spacingAfter": "var(--space-base)",
